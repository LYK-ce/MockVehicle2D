{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockvehicle2d/instruction/v3",
  "title": "Vehicle Instruction Specification v3",
  "type": "object",
  "required": ["intent", "parameters"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["stop", "goto", "clarify", "patrol"],
      "description": "解析出的用户意图"
    },
    "parameters": {
      "type": "object",
      "description": "意图相关参数，根据 intent 不同而不同"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "intent": { "const": "stop" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "goto" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["x_m", "y_m"],
            "properties": {
              "x_m": { "type": "number", "description": "目标 X 坐标 (米)" },
              "y_m": { "type": "number", "description": "目标 Y 坐标 (米)" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "patrol" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "intent": { "const": "clarify" } },
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["question"],
            "properties": {
              "question": { "type": "string", "description": "向用户提出的澄清问题" },
              "missing_parameters": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
